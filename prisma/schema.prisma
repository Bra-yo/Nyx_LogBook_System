generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  name                       String
  password                   String
  role                       UserRole
  avatar                     String?
  isActive                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  mustChangePassword         Boolean                   @default(false)
  registrationIdentifier     String?                   @unique
  phone                      String?
  paymentStatus              PaymentStatus             @default(PENDING)
  accountStatus              AccountStatus             @default(PENDING_PAYMENT)
  paymentConfirmedAt         DateTime?
  paymentConfirmedBy         String?
  bio                        String?
  skills                     String[]                  @default([])
  certificates               Json?
  socialLinks                Json?
  adminProfile               AdminProfile?
  allocatedMentorAllocations LearnerMentorAllocation[] @relation("AllocatedMentorAllocations")
  activityTimelineEntries    ActivityTimelineEntry[]
  announcementsCreated       Announcement[]            @relation("AnnouncementAuthor")
  auditLogs                  AuditLog[]
  conversationsInitiated     Conversation[]            @relation("ConversationParticipantOne")
  conversationsReceived      Conversation[]            @relation("ConversationParticipantTwo")
  lecturerProfile            LecturerProfile?
  emailDeliveries            EmailDelivery[]
  learnerLearningPaths       LearnerLearningPath[]
  messagesReceived           Message[]                 @relation("MessageRecipient")
  messagesSent               Message[]                 @relation("MessageSender")
  notifications              Notification[]
  preference                 UserPreference?
  sessions                   Session[]
  studentProfile             StudentProfile?
  supervisorProfile          SupervisorProfile?
  workerProfile              WorkerProfile?

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum LearningStatus {
  ACTIVE
  INACTIVE

  @@map("learning_status")
}

enum CompetencyDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("competency_difficulty")
}

enum LearnerPathStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("learner_path_status")
}

enum MentorAllocationStatus {
  PENDING
  ACTIVE
  COMPLETED
  ENDED
  REASSIGNED

  @@map("mentor_allocation_status")
}

enum MentorAllocationReason {
  AUTO_MATCH
  MANUAL_ASSIGNMENT
  WORKLOAD_BALANCING
  SPECIALIST_REQUEST
  MENTOR_LEFT
  LEARNER_REQUEST

  @@map("mentor_allocation_reason")
}

/// Represents an academic learning area that groups related competencies and conceptually extends the existing department structure.
model LearningArea {
  id            String            @id @default(cuid())
  name          String            @unique
  code          String            @unique
  description   String?
  status        LearningStatus    @default(ACTIVE)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  announcements Announcement[]
  competencies  Competency[]
  students      StudentProfile[]
  supervisors   SupervisorProfile[]

  @@index([status])
  @@index([sortOrder])
  @@map("learning_areas")
}

/// Represents a competency that belongs to one learning area and can be used across academic and assessment workflows.
model Competency {
  id                     String                @id @default(cuid())
  code                   String                @unique
  learningAreaId         String
  name                   String
  description            String?
  status                 LearningStatus        @default(ACTIVE)
  difficulty             CompetencyDifficulty?
  estimatedDurationWeeks Int?
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  learningArea           LearningArea          @relation(fields: [learningAreaId], references: [id], onDelete: Cascade)
  competencyGroups       CompetencyGroup[]
  learnerLearningPaths   LearnerLearningPath[]

  @@unique([learningAreaId, name])
  @@index([learningAreaId, status])
  @@index([status])
  @@index([sortOrder])
  @@map("competencies")
}

/// Represents a competency group that belongs to one competency and can be used for future grouping workflows.
model CompetencyGroup {
  id                     String                  @id @default(cuid())
  name                   String
  code                   String                  @unique
  competencyId           String
  description            String?
  status                 LearningStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  competency             Competency              @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  mentorCompetencyGroups MentorCompetencyGroup[]

  @@unique([competencyId, name])
  @@index([competencyId, status])
  @@index([status])
  @@map("competency_groups")
}

model LearnerLearningPath {
  id                String                    @id @default(cuid())
  learnerId         String
  competencyId      String
  status            LearnerPathStatus         @default(PLANNED)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assessments       CompetencyAssessment[]
  learner           User                      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  competency        Competency                @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  mentorAllocations LearnerMentorAllocation[]
  logbookEntries    LogbookEntry[]
  studentProfiles   StudentProfile[]

  @@index([learnerId, competencyId])
  @@index([learnerId, status])
  @@index([competencyId, status])
  @@index([status])
  @@map("learner_learning_paths")
}

model LearnerMentorAllocation {
  id               String                 @id @default(cuid())
  learningPathId   String
  mentorId         String
  status           MentorAllocationStatus @default(PENDING)
  allocationReason MentorAllocationReason @default(AUTO_MATCH)
  allocatedBy      String?
  startedAt        DateTime
  endedAt          DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  learningPath     LearnerLearningPath    @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  mentor           SupervisorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  allocatedByUser  User?                  @relation("AllocatedMentorAllocations", fields: [allocatedBy], references: [id])

  @@index([mentorId, status])
  @@index([learningPathId, status])
  @@index([status])
  @@map("learner_mentor_allocations")
}

model MentorCompetencyGroup {
  id                String            @id @default(cuid())
  mentorId          String
  competencyGroupId String
  status            LearningStatus    @default(ACTIVE)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  mentor            SupervisorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  competencyGroup   CompetencyGroup   @relation(fields: [competencyGroupId], references: [id], onDelete: Cascade)

  @@unique([mentorId, competencyGroupId])
  @@index([mentorId, status])
  @@index([competencyGroupId, status])
  @@index([status])
  @@map("mentor_competency_groups")
}

model Department {
  id            String              @id @default(cuid())
  name          String              @unique
  code          String              @unique
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  adminProfiles AdminProfile[]
  lecturers     LecturerProfile[]
  Milestone     Milestone[]
  Project       Project[]
  students      StudentProfile[]
  supervisors   SupervisorProfile[]

  @@map("departments")
}

model Project {
  id              String             @id @default(cuid())
  title           String
  description     String?
  companyName     String?
  departmentId    String?
  mentorId        String?
  status          ProjectStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  actualEndDate   DateTime?
  expectedEndDate DateTime?
  projectCode     String?            @unique
  projectName     String?
  startDate       DateTime?
  supervisorId    String?
  learners        ProjectLearner[]
  LogbookEntry    LogbookEntry[]
  milestones      Milestone[]
  projectMembers  ProjectMember[]
  department      Department?        @relation(fields: [departmentId], references: [id])
  mentor          SupervisorProfile? @relation("MentorProjects", fields: [mentorId], references: [id])
  supervisor      SupervisorProfile? @relation("SupervisorProjects", fields: [supervisorId], references: [id])
  tasks           Task[]

  @@map("projects")
}

model ProjectLearner {
  id         String         @id @default(cuid())
  projectId  String
  learnerId  String
  assignedAt DateTime       @default(now())
  learner    StudentProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, learnerId])
}

model Cohort {
  id                  String                   @id @default(cuid())
  name                String
  code                String                   @unique
  mentorshipTrack     MentorshipTrack
  status              CohortStatus             @default(UPCOMING)
  description         String?
  maximumCapacity     Int                      @default(25)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  clickupListId       String?
  clickupLastSyncedAt DateTime?
  clickupSyncStatus   String?
  clickupSyncError    String?
  members             StudentProfile[]
  mentorAssignments   CohortMentorAssignment[]

  @@map("cohorts")
}

model CohortMentorAssignment {
  id           String            @id @default(cuid())
  cohortId     String
  supervisorId String
  assignedAt   DateTime          @default(now())
  cohort       Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  mentor       SupervisorProfile @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([cohortId, supervisorId])
  @@map("cohort_mentor_assignments")
}

model StudentProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  regNumber              String                   @unique
  departmentId           String
  learningAreaId         String?
  supervisorId           String?
  mentorId               String?
  lecturerId             String?
  cohortId               String?
  learningPathId         String?
  mentorshipTrack        MentorshipTrack?
  registrationType       RegistrationType?
  year                   Int
  semester               Int
  internshipCompany      String?
  internshipStartDate    DateTime?
  internshipEndDate      DateTime?
  onboardingCompleted    Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  clickupTaskId          String?
  clickupLastSyncedAt    DateTime?
  clickupSyncStatus      String?
  clickupSyncError       String?
  ProjectLearner         ProjectLearner[]
  attendanceRecords      Attendance[]
  assessments            LecturerAssessment[]
  logbookEntries         LogbookEntry[]
  Milestone              Milestone[]
  cohort                 Cohort?                  @relation(fields: [cohortId], references: [id])
  department             Department               @relation(fields: [departmentId], references: [id])
  learningArea           LearningArea?            @relation(fields: [learningAreaId], references: [id], onDelete: SetNull)
  lecturer               LecturerProfile?         @relation(fields: [lecturerId], references: [id])
  supervisor             SupervisorProfile?       @relation(fields: [supervisorId], references: [id])
  mentor                 SupervisorProfile?       @relation("MentoredStudents", fields: [mentorId], references: [id], onDelete: SetNull)
  learningPath           LearnerLearningPath?     @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  WeeklyMentorTaskReview WeeklyMentorTaskReview[]

  @@map("student_profiles")
}

model WorkerProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  erpEmployeeId      String?
  staffNumber        String?         @unique
  firstName          String?
  middleName         String?
  lastName           String?
  fullName           String?
  email              String?
  phoneNumber        String?
  department         String?
  jobTitle           String?
  employmentStatus   String?
  nationalId         String?
  dateEmployed       DateTime?
  gender             String?
  lastSyncTime       DateTime?
  erpUpdatedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  attendanceRecords  Attendance[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("AssignedTasks")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerWorkLogs     TaskWorkLog[]

  @@map("worker_profiles")
}

model ProjectMember {
  id        String        @id @default(cuid())
  projectId String
  workerId  String
  joinedAt  DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([projectId, workerId])
  @@map("project_members")
}

model Task {
  id                String         @id @default(cuid())
  projectId         String
  assignedWorkerId  String?
  taskTitle         String
  taskDescription   String?
  priority          TaskPriority   @default(MEDIUM)
  status            TaskStatus     @default(PENDING)
  expectedStartDate DateTime?
  expectedEndDate   DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  assignedWorker    WorkerProfile? @relation("AssignedTasks", fields: [assignedWorkerId], references: [id])
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workLogs          TaskWorkLog[]

  @@map("tasks")
}

model TaskWorkLog {
  id                   String             @id @default(cuid())
  taskId               String
  workerId             String
  workDate             DateTime
  startTime            DateTime?
  endTime              DateTime?
  hoursWorked          Float?
  progressDescription  String
  achievements         String?
  challenges           String?
  completionPercentage Int?
  supervisorComments   String?
  status               LogStatus          @default(DRAFT)
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  reviewedBySupervisor SupervisorProfile? @relation("ReviewedTaskWorkLogs", fields: [reviewedBy], references: [id])
  task                 Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker               WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([taskId, workerId, workDate])
  @@map("worker_work_logs")
}

model SupervisorProfile {
  id                       String                      @id @default(cuid())
  userId                   String                      @unique
  departmentId             String
  learningAreaId           String?
  title                    String?
  company                  String?
  mentorCapacity           Int                         @default(10)
  employmentType           String?
  maxActiveMentees         Int                         @default(10)
  isAcceptingNewMentees    Boolean                     @default(true)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  milestoneAssessments     MilestoneMentorAssessment[]
  Milestone                Milestone[]
  officeLocations          OfficeLocation[]
  mentoredProjects         Project[]                   @relation("MentorProjects")
  supervisedProjects       Project[]                   @relation("SupervisorProjects")
  students                 StudentProfile[]
  mentoredStudents         StudentProfile[]            @relation("MentoredStudents")
  comments                 SupervisorComment[]
  cohortAssignments        CohortMentorAssignment[]
  department               Department                  @relation(fields: [departmentId], references: [id])
  learningArea             LearningArea?               @relation(fields: [learningAreaId], references: [id], onDelete: SetNull)
  learnerMentorAllocations LearnerMentorAllocation[]
  assessments              CompetencyAssessment[]
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  WeeklyMentorTaskReview   WeeklyMentorTaskReview[]
  reviewedTaskWorkLogs     TaskWorkLog[]               @relation("ReviewedTaskWorkLogs")
  mentorCompetencyGroups   MentorCompetencyGroup[]

  @@map("supervisor_profiles")
}

model LecturerProfile {
  id                   String                        @id @default(cuid())
  userId               String                        @unique
  departmentId         String
  title                String?
  office               String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  assessments          LecturerAssessment[]
  department           Department                    @relation(fields: [departmentId], references: [id])
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneAssessments MilestoneLecturerAssessment[]
  students             StudentProfile[]

  @@map("lecturer_profiles")
}

model AdminProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  departmentId String
  permissions  String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments  CompetencyAssessment[]

  @@map("admin_profiles")
}

model CompetencyAssessment {
  id                    String               @id @default(cuid())
  learnerLearningPathId String
  assessedBySupervisorId String?
  assessedByAdminId     String?
  assessmentDate        DateTime             @default(now())
  score                 Int
  level                 CompetencyLevel      @default(NOT_YET_DEMONSTRATED)
  comments              String?
  evidence              String?
  status                CompetencyAssessmentStatus @default(DRAFT)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  learnerLearningPath   LearnerLearningPath  @relation(fields: [learnerLearningPathId], references: [id], onDelete: Cascade)
  assessedBySupervisor  SupervisorProfile?   @relation(fields: [assessedBySupervisorId], references: [id], onDelete: SetNull)
  assessedByAdmin       AdminProfile?        @relation(fields: [assessedByAdminId], references: [id], onDelete: SetNull)

  @@index([learnerLearningPathId, status])
  @@index([status, assessmentDate])
  @@map("competency_assessments")
}

enum EvidenceType {
  DOCUMENT
  IMAGE
  VIDEO
  LINK
  SOURCE_CODE

  @@map("evidence_type")
}

model LogbookEntryEvidence {
  id             String       @id @default(cuid())
  logbookEntryId String
  type           EvidenceType
  title          String?
  url            String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  logbookEntry   LogbookEntry @relation(fields: [logbookEntryId], references: [id], onDelete: Cascade)

  @@index([logbookEntryId])
  @@map("logbook_entry_evidence")
}

model LogbookEntry {
  id                String                   @id @default(cuid())
  studentId         String
  learningPathId    String?
  title             String
  description       String
  activities        String
  hoursWorked       Float?
  challenges        String?
  learnings         String?
  date              DateTime
  status            LogStatus                @default(DRAFT)
  attachments       String[]                 @default([])
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  milestoneId       String?
  milestoneTaskId   String?
  projectId         String?
  assessments       LecturerAssessment?
  milestone         Milestone?               @relation(fields: [milestoneId], references: [id])
  milestoneTask     MilestoneTask?           @relation(fields: [milestoneTaskId], references: [id])
  project           Project?                 @relation(fields: [projectId], references: [id])
  student           StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningPath     LearnerLearningPath?     @relation(fields: [learningPathId], references: [id])
  evidenceItems    LogbookEntryEvidence[]
  comments          SupervisorComment[]

  @@index([learningPathId])
  @@map("logbook_entries")
}

model SupervisorComment {
  id                    String                 @id @default(cuid())
  logbookEntryId        String
  supervisorId          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  competencyDescription String
  competencyLabel       String
  competencyScore       Int
  optionalComment       String?
  status                SupervisorReviewStatus @default(PENDING)
  logbookEntry          LogbookEntry           @relation(fields: [logbookEntryId], references: [id], onDelete: Cascade)
  supervisor            SupervisorProfile      @relation(fields: [supervisorId], references: [id])

  @@map("supervisor_comments")
}

model LecturerAssessment {
  id                   String           @id @default(cuid())
  studentId            String
  logbookEntryId       String?          @unique
  lecturerId           String
  technicalScore       Int?
  communicationScore   Int?
  professionalismScore Int?
  overallScore         Int?
  feedback             String?
  status               LecturerAssessmentStatus @default(NOT_ASSESSED)
  assessedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lecturer             LecturerProfile  @relation(fields: [lecturerId], references: [id])
  logbookEntry         LogbookEntry?    @relation(fields: [logbookEntryId], references: [id])
  student              StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("lecturer_assessments")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String
  category    String   @default("GENERAL")
  priority    String   @default("NORMAL")
  read        Boolean  @default(false)
  archived    Boolean  @default(false)
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, archived, createdAt])
  @@map("notifications")
}

model Announcement {
  id              String         @id @default(cuid())
  title           String
  body            String
  audienceRole    String?
  learningAreaId  String?
  priority        String         @default("NORMAL")
  scheduleAt      DateTime?
  expiresAt       DateTime?
  isActive        Boolean        @default(true)
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User           @relation("AnnouncementAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)
  learningArea    LearningArea?  @relation(fields: [learningAreaId], references: [id], onDelete: SetNull)

  @@index([isActive, expiresAt, createdAt])
  @@map("announcements")
}

model Conversation {
  id                String    @id @default(cuid())
  participantOneId  String
  participantTwoId  String
  subject           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastMessageAt     DateTime?
  participantOne    User      @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo    User      @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([participantOneId, participantTwoId])
  @@map("conversations")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  recipientId    String?
  body            String
  attachmentName  String?
  attachmentUrl   String?
  readAt          DateTime?
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient       User?        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  notificationCategories Json   @default("[]")
  emailPreferences    Json     @default("{}")
  inAppNotifications  Boolean  @default(true)
  reminderFrequency   String   @default("DAILY")
  quietHoursStart     String?  @default("22:00")
  quietHoursEnd       String?  @default("07:00")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ActivityTimelineEntry {
  id          String   @id @default(cuid())
  userId      String
  eventType   String
  title       String
  description String?
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_timeline_entries")
}

model EmailDelivery {
  id             String              @id @default(cuid())
  userId         String
  toEmail        String
  subject        String
  htmlBody       String
  attachmentPath String
  attachmentName String
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("email_deliveries")
}

model Attendance {
  id               String           @id @default(cuid())
  studentId        String?
  officeLocationId String
  checkInTime      DateTime
  checkOutTime     DateTime?
  checkInLat       Float
  checkInLng       Float
  checkOutLat      Float?
  checkOutLng      Float?
  status           AttendanceStatus @default(ACTIVE)
  hoursWorked      Float?
  qrCodeData       String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workerId         String?
  officeLocation   OfficeLocation   @relation(fields: [officeLocationId], references: [id])
  student          StudentProfile?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  worker           WorkerProfile?   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model OfficeLocation {
  id         String             @id @default(cuid())
  name       String
  address    String
  latitude   Float
  longitude  Float
  radius     Float              @default(100)
  isActive   Boolean            @default(true)
  qrCodeData String             @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  mentorId   String?
  attendance Attendance[]
  mentor     SupervisorProfile? @relation(fields: [mentorId], references: [id])

  @@map("office_locations")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Milestone {
  id                 String                       @id @default(cuid())
  learnerId          String?
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime
  status             MilestoneStatus              @default(PENDING)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  departmentId       String?
  mentorId           String?
  projectId          String?
  entries            LogbookEntry[]
  lecturerAssessment MilestoneLecturerAssessment?
  mentorAssessment   MilestoneMentorAssessment?
  tasks              MilestoneTask[]
  department         Department?                  @relation(fields: [departmentId], references: [id])
  learner            StudentProfile?              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  mentor             SupervisorProfile?           @relation(fields: [mentorId], references: [id])
  project            Project?                     @relation(fields: [projectId], references: [id])
  weeklyReviews      WeeklyMentorTaskReview[]

  @@map("milestones")
}

model MilestoneTask {
  id             String                   @id @default(cuid())
  milestoneId    String
  title          String
  description    String?
  expectedOutput String?
  dueDate        DateTime?
  status         MilestoneTaskStatus      @default(PENDING)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  entries        LogbookEntry[]
  milestone      Milestone                @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  weeklyReviews  WeeklyMentorTaskReview[]

  @@map("milestone_tasks")
}

model MilestoneMentorAssessment {
  id              String                 @id @default(cuid())
  milestoneId     String                 @unique
  mentorId        String
  competencyLevel Int
  status          SupervisorReviewStatus @default(PENDING)
  comment         String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  mentor          SupervisorProfile      @relation(fields: [mentorId], references: [id])
  milestone       Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@map("milestone_mentor_assessments")
}

model MilestoneLecturerAssessment {
  id                   String          @id @default(cuid())
  milestoneId          String          @unique
  lecturerId           String
  technicalScore       Int?
  communicationScore   Int?
  professionalismScore Int?
  overallScore         Int?
  feedback             String?
  status               String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lecturer             LecturerProfile @relation(fields: [lecturerId], references: [id])
  milestone            Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@map("milestone_lecturer_assessments")
}

model WeeklyMentorTaskReview {
  id              String                 @id @default(cuid())
  milestoneId     String
  milestoneTaskId String?
  mentorId        String
  learnerId       String
  weekStartDate   DateTime
  weekEndDate     DateTime
  competencyLevel Int
  comment         String?
  status          SupervisorReviewStatus
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  learner         StudentProfile         @relation(fields: [learnerId], references: [id])
  mentor          SupervisorProfile      @relation(fields: [mentorId], references: [id])
  milestone       Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneTask   MilestoneTask?         @relation(fields: [milestoneTaskId], references: [id])

  @@map("weekly_mentor_task_reviews")
}

enum CompetencyAssessmentStatus {
  DRAFT
  SUBMITTED
  FINAL
}

enum CompetencyLevel {
  NOT_YET_DEMONSTRATED
  EMERGING
  COMPETENT
  PROFICIENT
  EXPERT
}

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RegistrationType {
  CAREER_MENTEE
  BUSINESS_MENTEE
}

enum MentorshipTrack {
  CAREER
  BUSINESS
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  MENTOR_REVIEWED
  LECTURER_REVIEWED
  COMPLETED
}

enum LogStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

enum UserRole {
  STUDENT
  SUPERVISOR
  LECTURER
  ADMIN
  WORKER
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

enum AccountStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AttendanceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LecturerAssessmentStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLETED
}

enum SupervisorReviewStatus {
  APPROVED
  NEEDS_REVISION
  REJECTED
  PENDING
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MilestoneTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}
